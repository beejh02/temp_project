VITE_NAVER_MAP_CLIENT_ID=your_naver_maps_client_id

# 로컬 Vite 개발 서버가 /api 요청을 전달할 백엔드 주소입니다.
VITE_API_TARGET=http://localhost:8080

# 기본값은 /api 프록시를 사용하는 proxy입니다.
# Render를 브라우저에서 직접 호출할 때만 direct로 변경합니다.
VITE_API_MODE=proxy
VITE_API_BASE_URL=

# Style Editor에서 발행한 My Style ID입니다.
# 설정하면 GL 커스텀 지도를 사용하며, 비워두면 Geocoder 기반 일반 지도를 사용합니다.
VITE_NAVER_MAP_STYLE_ID=
